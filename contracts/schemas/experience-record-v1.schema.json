{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knolo.dev/schemas/experience-record-v1.schema.json",
  "title": "ExperienceRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "runId",
    "sequence",
    "patternKey",
    "objective",
    "successCriteria",
    "status",
    "useful",
    "text",
    "skillIds",
    "requiredCapabilities",
    "evidenceIds",
    "dependencyRoot",
    "successCriteriaMatched",
    "prohibitedViolations",
    "labels"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string" },
    "runId": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 1 },
    "patternKey": { "type": "string" },
    "objective": { "type": "string" },
    "successCriteria": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["succeeded", "partial", "failed", "suspended"] },
    "useful": { "type": "boolean" },
    "text": { "type": "string" },
    "skillIds": { "type": "array", "items": { "type": "string" } },
    "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
    "evidenceIds": { "type": "array", "items": { "type": "string" } },
    "dependencyRoot": { "type": "string" },
    "successCriteriaMatched": { "type": "array", "items": { "type": "string" } },
    "prohibitedViolations": { "type": "array", "items": { "type": "string" } },
    "labels": { "type": "array", "items": { "type": "string" } }
  }
}
