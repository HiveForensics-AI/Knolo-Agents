{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knolo.dev/schemas/acs-harness-report-v1.schema.json",
  "title": "AcsHarnessReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "target", "baselineMean", "harnessMean", "relativeUplift", "meetsTarget", "suites"],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "acs-harness-report" },
    "target": { "type": "number" },
    "baselineMean": { "type": "number" },
    "harnessMean": { "type": "number" },
    "relativeUplift": { "type": "number" },
    "meetsTarget": { "type": "boolean" },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suiteId", "baseline", "harnessed", "uplift", "relativeUplift", "meetsTarget"],
        "properties": {
          "suiteId": { "type": "string", "minLength": 1 },
          "baseline": { "type": "number" },
          "harnessed": { "type": "number" },
          "uplift": { "type": "number" },
          "relativeUplift": { "type": "number" },
          "meetsTarget": { "type": "boolean" }
        }
      }
    }
  }
}
