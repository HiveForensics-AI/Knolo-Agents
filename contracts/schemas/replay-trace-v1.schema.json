{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knolo.dev/schemas/replay-trace-v1.schema.json",
  "title": "ReplayTraceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "events", "snapshots"],
  "properties": {
    "version": { "const": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "sequence", "execution_id", "node_id", "timestamp_ms", "kind"],
        "properties": {
          "version": { "const": 1 },
          "sequence": { "type": "integer", "minimum": 1 },
          "execution_id": { "type": "string", "minLength": 1 },
          "node_id": { "type": ["string", "null"] },
          "timestamp_ms": { "type": "integer", "minimum": 0 },
          "kind": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } } }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_id", "revision", "value", "provenance"],
        "properties": {
          "schema_id": { "type": "string", "minLength": 1 },
          "revision": { "type": "integer", "minimum": 0 },
          "value": true,
          "provenance": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["execution_id", "node_id", "event_sequence"],
            "properties": {
              "execution_id": { "type": "string" },
              "node_id": { "type": "string" },
              "event_sequence": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
