{
  "name": "@knolo/agents",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript agent interfaces for Knolo.",
  "license": "MIT",
  "peerDependencies": {
    "@knolo/core": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "main": "./dist/node.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.types.json",
