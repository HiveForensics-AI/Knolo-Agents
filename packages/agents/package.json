{
  "name": "@knolo/agents",
  "version": "0.2.1",
  "type": "module",
  "description": "Typed graph builders, explicit TypeScript/WASM adapters, and the additive universal harness for Knolo Agents.",
  "license": "Apache-2.0",
  "author": "Knolo contributors",
  "sideEffects": false,
  "peerDependencies": {
    "@knolo/core": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@knolo/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@knolo/core": "^5.1.0",
    "typescript": "^5.6.3"
  },
  "main": "./dist/node.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.types.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HiveForensics-AI/Knolo-Agents.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/HiveForensics-AI/Knolo-Agents#readme",
  "bugs": {
    "url": "https://github.com/HiveForensics-AI/Knolo-Agents/issues"
  },
  "keywords": [
    "knolo",
    "agents",
    "ai",
    "typescript"
  ]
}
